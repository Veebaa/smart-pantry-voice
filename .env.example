# Active application: React/Vite -> Express -> Drizzle -> PostgreSQL
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/sage
# Local/development PostgreSQL connects without SSL; production connections require SSL.

# Optional comma-separated browser origins allowed to make credentialed API requests.
# In production, configure this with your actual app origin(s); no production domain is assumed.
# Development also allows localhost and loopback origins for local Vite use.
CORS_ALLOWED_ORIGINS=

# Required for AI assistant and text-to-speech routes
OPENAI_API_KEY=your_openai_api_key_here
